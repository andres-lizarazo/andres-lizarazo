---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---
<Base title="Página no encontrada · Ruta Analista" description="Esta página no existe." noindex>
  <main id="contenido" class="container-page flex min-h-screen max-w-xl flex-col items-center justify-center gap-6 text-center">
    <Logo />
    <h1 class="text-4xl font-black">Esta página no existe</h1>
    <p class="text-muted">Puede que el enlace esté mal escrito. Sigue por aquí:</p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a class="btn-cta" href="/">Ver el kit</a>
      <a class="inline-flex min-h-[3.25rem] items-center justify-center rounded-xl border-2 border-ink px-6 font-extrabold" href="/gratis">15 ejercicios gratis</a>
    </div>
  </main>
</Base>
