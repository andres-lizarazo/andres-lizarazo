---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import CheckoutButton from '../components/CheckoutButton.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { es } from '../content/es';
const bonus = site.launchBonus;
---
<Base title="¡Listo! Revisa tu correo · Ruta Analista" description="Tus 15 ejercicios SQL van camino a tu correo." noindex>
  <div class="bg-navy text-white">
    <div class="container-page py-5"><Logo light /></div>
    <main id="contenido" class="container-page max-w-3xl pb-14 pt-6 text-center">
      <p class="eyebrow text-accent">Paso 1 de 2 completado</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl">¡Listo<span data-lead-name></span>! Revisa tu correo.</h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-slate-200">Te envié los ejercicios. Si no los ves en 5 minutos, revisa <strong>Promociones</strong> o <strong>Spam</strong> y muévelos a tu bandeja principal para recibir los siguientes.</p>
      <div class="mx-auto mt-8 max-w-md rounded-2xl bg-white p-5 text-left text-ink">
        <p class="font-extrabold">¿Lo quieres ya? Descárgalo aquí:</p>
        <ul class="mt-3 space-y-2">
          {site.leadMagnet.files.map((f) => (
            <li>
              <a href={f.href} data-download={f.href} download class="flex items-center gap-2 font-semibold text-brand underline-offset-4 hover:underline">
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 21h16"/></svg>
                {f.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </main>
  </div>

  <section class="section" aria-labelledby="oferta-title">
    <div class="container-page max-w-3xl">
      <div class="rounded-3xl border-2 border-accent bg-white p-7 shadow-xl sm:p-10">
        <p class="eyebrow text-brand">Paso 2 (opcional)</p>
        <h2 id="oferta-title" class="h2 mt-2">Los 15 ejercicios son el comienzo. El kit completo es el camino.</h2>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          Si de verdad quieres tu primer empleo en datos, necesitas más que práctica de SQL: un portafolio que demuestre que resuelves problemas de negocio, un CV que pase los filtros y preparación para la entrevista.
        </p>
        <ul class="mt-6 grid gap-2 sm:grid-cols-2">
          {es.pricing.items.map((item) => (
            <li class="flex gap-2">
              <svg aria-hidden="true" class="mt-1 shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0f766e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              {item}
            </li>
          ))}
        </ul>
        {bonus.enabled && (
          <p class="mt-6 rounded-xl bg-accent/20 p-4 text-sm leading-relaxed"><strong>{bonus.title}:</strong> {bonus.text}</p>
        )}
        <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row">
          <CheckoutButton label={`Quiero el kit completo por $${site.product.price}`} placement="gracias" />
          <a href="/" class="text-sm font-semibold text-muted underline underline-offset-4">Ver todo lo que incluye</a>
        </div>
        <p class="mt-4 text-sm text-muted">Pago único · Garantía de {site.product.guaranteeDays} días · Acceso inmediato</p>
      </div>
    </div>
  </section>
  <Footer />
  <script>
    import { getLead } from '../scripts/track';
    const name = getLead().name?.split(' ')[0];
    const el = document.querySelector('[data-lead-name]');
    if (el && name) el.textContent = `, ${name}`;
  </script>
</Base>
