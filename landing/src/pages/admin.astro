---
// Panel privado de métricas. Los datos llegan del API protegido (/api/admin/*) solo con el ADMIN_TOKEN;
// esta página no contiene ningún dato y no se indexa.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { site } from '../config/site';

const tables = [
  { id: 'leads', label: 'Leads' },
  { id: 'purchases', label: 'Compras' },
  { id: 'funnel', label: 'Embudo por fuente' },
  { id: 'events', label: 'Eventos' },
];
---
<Base title="Panel · Ruta Analista" description="Panel privado de métricas de Ruta Analista." noindex analytics={false}>
  <header class="border-b border-line bg-white">
    <div class="container-page flex items-center justify-between py-4">
      <Logo />
      <span class="text-sm font-semibold text-muted">Panel privado</span>
    </div>
  </header>

  <main id="contenido" class="container-page max-w-5xl py-8" data-goal={site.goalBuyers}>
    <section id="login" class="mx-auto max-w-md rounded-2xl border border-line bg-white p-6 shadow-sm sm:p-8">
      <h1 class="text-2xl font-black tracking-tight">Panel de métricas</h1>
      <p class="mt-2 text-sm text-muted">Escribe tu <code>ADMIN_TOKEN</code>. Se guarda solo en esta pestaña y se borra al cerrarla.</p>
      <form id="login-form" class="mt-6 grid gap-3">
        <label for="admin-token" class="text-sm font-semibold">Token de administrador</label>
        <input id="admin-token" name="token" type="password" required minlength="16" autocomplete="current-password"
          class="rounded-lg border border-line bg-white px-3 py-2.5 text-base outline-none focus:border-brand" />
        <button type="submit" class="mt-1 rounded-lg bg-navy px-4 py-2.5 font-bold text-white hover:bg-navy-2">Entrar</button>
        <p id="login-error" role="alert" class="min-h-5 text-sm font-semibold text-red-700"></p>
      </form>
    </section>

    <section id="panel" hidden aria-labelledby="panel-title">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h1 id="panel-title" class="text-2xl font-black tracking-tight sm:text-3xl">Panel de métricas</h1>
          <p class="mt-1 text-sm text-muted">Actualizado: <span id="updated-at">—</span></p>
        </div>
        <div class="flex gap-2">
          <button id="refresh" type="button" class="rounded-lg border border-line bg-white px-3 py-2 text-sm font-semibold hover:border-brand">Actualizar</button>
          <button id="logout" type="button" class="rounded-lg border border-line bg-white px-3 py-2 text-sm font-semibold hover:border-brand">Salir</button>
        </div>
      </div>

      <!-- Cifra principal: compradores frente a la meta -->
      <div class="mt-6 grid gap-4 rounded-2xl bg-navy p-6 text-white sm:grid-cols-[1.4fr_1fr] sm:p-8">
        <div>
          <p class="text-sm font-semibold text-slate-300">Compradores</p>
          <p class="mt-1 flex items-baseline gap-3">
            <span id="hero-buyers" class="text-6xl font-black leading-none">0</span>
            <span class="text-base text-slate-300">de <span id="hero-goal">{site.goalBuyers.toLocaleString('es-CO')}</span> (meta)</span>
          </p>
          <div class="mt-5 h-2 w-full rounded-full bg-accent/25" role="meter" id="goal-meter" aria-label="Avance hacia la meta de compradores"
            aria-valuemin="0" aria-valuemax={site.goalBuyers} aria-valuenow="0">
            <div id="goal-fill" class="h-2 rounded-full bg-accent" style="width:0%"></div>
          </div>
          <p class="mt-2 text-sm text-slate-300"><span id="goal-pct">0%</span> de la meta</p>
        </div>
        <div class="sm:border-l sm:border-white/15 sm:pl-6">
          <p class="text-sm font-semibold text-slate-300">Ingresos aprobados</p>
          <ul id="revenue" class="mt-1 grid gap-1 text-2xl font-black"><li>—</li></ul>
          <p class="mt-3 text-xs text-slate-400">Valor bruto reportado por Hotmart, sin descontar comisiones.</p>
        </div>
      </div>

      <!-- KPI -->
      <h2 class="sr-only">Indicadores</h2>
      <dl id="kpis" class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4"></dl>

      <!-- Embudo por fuente -->
      <h2 class="mt-10 text-xl font-black tracking-tight">Embudo por fuente</h2>
      <p class="mt-1 text-sm text-muted">Fuente = primer contacto (UTM, <code>?ref=</code> o referrer). Ordenado por compradores.</p>
      <div class="mt-4 overflow-x-auto rounded-2xl border border-line bg-white">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead class="border-b border-line text-xs uppercase tracking-wide text-muted">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold">Fuente</th>
              <th scope="col" class="px-4 py-3 font-semibold">Leads</th>
              <th scope="col" class="px-4 py-3 text-right font-semibold">Clic en comprar</th>
              <th scope="col" class="px-4 py-3 text-right font-semibold">Compradores</th>
              <th scope="col" class="px-4 py-3 text-right font-semibold">Clic → compra</th>
              <th scope="col" class="px-4 py-3 text-right font-semibold">Lead → compra</th>
            </tr>
          </thead>
          <tbody id="funnel" class="tabular-nums"></tbody>
        </table>
      </div>

      <!-- Descargas y mantenimiento -->
      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-line bg-white p-5">
          <h2 class="font-black">Descargar CSV</h2>
          <p class="mt-1 text-sm text-muted">Para Excel, Google Sheets o Power BI.</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {tables.map((t) => (
              <button type="button" data-csv={t.id} class="rounded-lg border border-line px-3 py-2 text-sm font-semibold hover:border-brand">{t.label}</button>
            ))}
          </div>
        </div>
        <div class="rounded-2xl border border-line bg-white p-5">
          <h2 class="font-black">Sincronización con Brevo</h2>
          <p class="mt-1 text-sm text-muted">Reintenta enviar a Brevo los leads y compras que quedaron pendientes.</p>
          <button id="resync" type="button" class="mt-3 rounded-lg bg-brand px-3 py-2 text-sm font-bold text-white hover:opacity-90">Reintentar ahora</button>
          <p id="resync-result" aria-live="polite" class="mt-2 min-h-5 text-sm text-muted"></p>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import { initAdmin } from '../scripts/admin';
  initAdmin();
</script>
