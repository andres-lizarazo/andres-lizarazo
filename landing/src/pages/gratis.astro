---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import LeadForm from '../components/LeadForm.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

const bullets = [
  'Preguntas tipo prueba técnica, ordenadas de fácil a difícil.',
  'Una base de datos de práctica (SQLite + CSV) para resolverlas de verdad.',
  'Soluciones explicadas paso a paso, con el porqué de cada línea.',
];
---
<Base
  title="Gratis: 15 ejercicios SQL de entrevistas de Analista de Datos (con soluciones)"
  description="Descarga gratis 15 ejercicios SQL tipo prueba técnica, con base de datos de práctica y soluciones explicadas. Por un BI & Analytics Manager."
>
  <div class="relative min-h-screen overflow-hidden bg-navy text-white">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-40" style="background: radial-gradient(50rem 26rem at 90% -10%, rgba(15,118,110,.6), transparent 60%);"></div>
    <div class="container-page relative py-5"><Logo light /></div>
    <main id="contenido" class="container-page relative grid gap-8 pb-16 pt-2 md:grid-cols-[1.1fr_.9fr] md:gap-x-14 md:gap-y-6 md:pt-10">
      <div class="md:col-start-1 md:row-start-1">
        <p class="eyebrow text-accent">Gratis · PDF + base de datos</p>
        <h1 class="mt-3 text-[2rem] font-black leading-[1.06] tracking-tight text-balance sm:text-5xl">15 ejercicios SQL que aparecen en entrevistas de Analista de Datos</h1>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-slate-200">Practica con el tipo de preguntas de una prueba técnica real. Con soluciones explicadas.</p>
      </div>
      <div class="rounded-3xl bg-white p-6 text-ink shadow-2xl sm:p-8 md:col-start-2 md:row-span-2 md:row-start-1 md:self-center">
        <h2 class="text-xl font-extrabold">¿A qué email te los envío?</h2>
        <p class="mt-1 text-sm text-muted">Llegan en menos de 2 minutos.</p>
        <div class="mt-5">
          <LeadForm formId="gratis" />
        </div>
      </div>
      <div class="md:col-start-1 md:row-start-2">
        <ul class="space-y-3">
          {bullets.map((b) => (
            <li class="flex gap-3 text-slate-100">
              <svg aria-hidden="true" class="mt-1 shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#facc15" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              {b}
            </li>
          ))}
        </ul>
        <p class="mt-8 text-sm text-slate-300">Por <strong class="text-white">{site.author.name}</strong>, {site.author.role}. Trabajo con clientes de EE.UU. y un equipo de analítica en Bogotá.</p>
      </div>
    </main>
  </div>
  <Footer />
</Base>
