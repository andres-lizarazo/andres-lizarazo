---
// Ilustración ligera del kit (SVG en línea, sin peso de imagen).
---
<svg viewBox="0 0 460 420" role="img" aria-label="Vista del Kit Ruta Analista: guía, ejercicios SQL y CV" class="h-auto w-full max-w-sm drop-shadow-2xl md:max-w-md">
  <defs>
    <linearGradient id="km-cv" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#eef2f7"/></linearGradient>
    <linearGradient id="km-cover" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0f766e"/><stop offset="1" stop-color="#0c1a2e"/></linearGradient>
  </defs>
  <!-- CV -->
  <g transform="rotate(-8 125 235)">
    <rect x="30" y="110" width="190" height="250" rx="14" fill="url(#km-cv)"/>
    <circle cx="66" cy="148" r="17" fill="#cbd5e1"/>
    <rect x="92" y="137" width="104" height="10" rx="5" fill="#0c1a2e"/>
    <rect x="92" y="155" width="74" height="8" rx="4" fill="#94a3b8"/>
    <rect x="50" y="186" width="150" height="7" rx="3.5" fill="#cbd5e1"/>
    <rect x="50" y="202" width="130" height="7" rx="3.5" fill="#cbd5e1"/>
    <rect x="50" y="218" width="140" height="7" rx="3.5" fill="#cbd5e1"/>
    <rect x="50" y="244" width="66" height="9" rx="4.5" fill="#0f766e"/>
    <rect x="50" y="262" width="150" height="7" rx="3.5" fill="#cbd5e1"/>
    <rect x="50" y="278" width="110" height="7" rx="3.5" fill="#cbd5e1"/>
    <text x="50" y="336" font-family="ui-sans-serif,system-ui" font-size="13" font-weight="800" fill="#0f766e">CV · ES / EN</text>
  </g>
  <!-- SQL -->
  <g transform="rotate(4 340 135)">
    <rect x="232" y="20" width="215" height="235" rx="14" fill="#0b1220"/>
    <circle cx="252" cy="42" r="5" fill="#f87171"/><circle cx="268" cy="42" r="5" fill="#facc15"/><circle cx="284" cy="42" r="5" fill="#34d399"/>
    <text x="430" y="46" text-anchor="end" font-family="ui-sans-serif,system-ui" font-size="11.5" font-weight="800" fill="#facc15">60 ejercicios SQL</text>
    <text font-family="ui-monospace,Menlo,monospace" font-size="12.5" fill="#e2e8f0">
      <tspan x="252" y="80" fill="#facc15">SELECT</tspan><tspan> categoria,</tspan>
      <tspan x="268" y="100">SUM(total) AS ventas</tspan>
      <tspan x="252" y="120" fill="#facc15">FROM</tspan><tspan> pedidos</tspan>
      <tspan x="252" y="140" fill="#facc15">GROUP BY</tspan><tspan> 1</tspan>
      <tspan x="252" y="160" fill="#facc15">ORDER BY</tspan><tspan> 2 DESC;</tspan>
    </text>
    <rect x="252" y="182" width="175" height="1" fill="#334155"/>
    <rect x="252" y="196" width="150" height="10" rx="3" fill="#34d399"/>
    <rect x="252" y="214" width="112" height="10" rx="3" fill="#34d399" opacity=".8"/>
    <rect x="252" y="232" width="78" height="10" rx="3" fill="#34d399" opacity=".6"/>
  </g>
  <!-- Portada -->
  <g>
    <rect x="118" y="172" width="214" height="240" rx="16" fill="url(#km-cover)"/>
    <rect x="138" y="194" width="62" height="20" rx="10" fill="#facc15"/>
    <text x="169" y="208" text-anchor="middle" font-family="ui-sans-serif,system-ui" font-size="10.5" font-weight="900" fill="#1c1600">KIT 2026</text>
    <text font-family="ui-sans-serif,system-ui" font-weight="900" fill="#ffffff">
      <tspan x="138" y="250" font-size="26">Ruta</tspan>
      <tspan x="138" y="280" font-size="26" fill="#facc15">Analista</tspan>
    </text>
    <text font-family="ui-sans-serif,system-ui" font-size="12" fill="#ccfbf1">
      <tspan x="138" y="304">Tu primer empleo</tspan>
      <tspan x="138" y="320">en datos, en 8 semanas</tspan>
    </text>
    <polyline points="140,390 170,370 198,378 230,348 260,358 308,322" fill="none" stroke="#facc15" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="308" cy="322" r="5.5" fill="#facc15"/>
  </g>
</svg>
