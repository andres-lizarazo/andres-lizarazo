---
import { es } from '../content/es';
import { site } from '../config/site';
import CheckoutButton from './CheckoutButton.astro';
const t = es.pricing;
const g = es.guarantee;
const bonus = site.launchBonus;
---
<section id="precio" class="section bg-white scroll-mt-4" aria-labelledby="precio-title">
  <div class="container-page grid items-start gap-10 lg:grid-cols-[1fr_minmax(0,28rem)]">
    <div>
      <p class="eyebrow text-brand">Precio</p>
      <h2 id="precio-title" class="h2 mt-2">{t.title}</h2>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted">{t.compare}</p>

      <div class="mt-8 flex max-w-xl gap-4 rounded-2xl border border-line bg-paper p-6">
        <svg aria-hidden="true" class="shrink-0" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#0f766e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
        <div>
          <h3 class="text-lg font-extrabold">{g.title}</h3>
          <p class="mt-1 leading-relaxed text-muted">{g.text}</p>
        </div>
      </div>
    </div>

    <div class="rounded-3xl bg-navy p-7 text-white shadow-2xl ring-1 ring-black/5 sm:p-8">
      <p class="text-sm font-bold uppercase tracking-wider text-accent">{site.product.name}</p>
      <p class="mt-3 flex items-end gap-2">
        <span class="text-6xl font-black tracking-tight">${site.product.price}</span>
        <span class="pb-2 text-lg font-semibold text-slate-300">{site.product.currency} · pago único</span>
      </p>
      <ul class="mt-6 space-y-3">
        {t.items.map((item) => (
          <li class="flex gap-3">
            <svg aria-hidden="true" class="mt-0.5 shrink-0" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      {bonus.enabled && (
        <div class="mt-6 rounded-xl bg-accent/15 p-4 ring-1 ring-accent/40">
          <p class="text-sm font-extrabold uppercase tracking-wide text-accent">{bonus.title}</p>
          <p class="mt-1 text-sm leading-relaxed text-slate-100">{bonus.text}</p>
        </div>
      )}
      <CheckoutButton label={t.cta} placement="pricing" full class="mt-7" />
      <p class="mt-3 text-center text-xs text-slate-300">{t.note}</p>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-[11px] font-semibold text-slate-300">
        {['Visa', 'Mastercard', 'PSE', 'Nequi', 'PayPal', 'Efecty'].map((m) => (
          <span class="rounded-md bg-white/10 px-2 py-1">{m}</span>
        ))}
      </div>
    </div>
  </div>
</section>
