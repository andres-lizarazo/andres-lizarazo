---
import { es } from '../content/es';
const t = es.faq;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---
<section class="section" aria-labelledby="faq-title">
  <div class="container-page max-w-3xl">
    <h2 id="faq-title" class="h2 text-center">{t.title}</h2>
    <div class="mt-10 divide-y divide-line rounded-2xl border border-line bg-white">
      {t.items.map((item) => (
        <details class="group p-5 sm:p-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-bold [&::-webkit-details-marker]:hidden">
            {item.q}
            <span aria-hidden="true" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-paper text-xl leading-none text-brand transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 leading-relaxed text-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>
