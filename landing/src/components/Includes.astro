---
import { es } from '../content/es';
const t = es.includes;
const icons = [
  'M3 6h18M3 12h12M3 18h7', // ruta
  'M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3Zm0 0v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3', // sql
  'M4 20V10M10 20V4M16 20v-7M22 20H2', // proyectos
  'M8 7a4 4 0 1 0 8 0 4 4 0 0 0-8 0M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1', // cv
  'M8 10h8M8 14h5M21 12a9 9 0 1 1-4.2-7.6L21 3l-1.2 4.3A8.9 8.9 0 0 1 21 12Z', // entrevista
  'M9 11l3 3 8-8M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9', // checklist
];
---
<section class="section bg-white" aria-labelledby="incluye-title">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow text-brand">El kit</p>
      <h2 id="incluye-title" class="h2 mt-2">{t.title}</h2>
      <p class="mt-4 text-lg text-muted">{t.subtitle}</p>
    </div>
    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {t.items.map((item, i) => (
        <li class="flex flex-col rounded-2xl border border-line bg-paper p-6">
          <div class="flex items-center justify-between">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-navy text-accent">
              <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={icons[i]} /></svg>
            </span>
            <span class="rounded-full bg-brand-soft px-2.5 py-1 text-xs font-bold text-brand">{item.tag}</span>
          </div>
          <h3 class="mt-5 text-lg font-extrabold">{item.title}</h3>
          <p class="mt-2 leading-relaxed text-muted">{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
